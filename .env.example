# Required — OpenAI-compatible model identifier.
# Set OPENAI_BASE_URL to use a compatible endpoint (DeepSeek, local Ollama, etc.).
OPENAI_API_KEY=<YOUR-API-KEY>
# OPENAI_BASE_URL=<YOUR-COMPATIBLE-ENDPOINT>
MODEL=gpt-4o

# Optional — only needed if you use TavilySearchTool instead of DuckDuckGoSearchTool.
# TAVILY_API_KEY=<YOUR-TAVILY-API-KEY>

# Local chat app (chat.yutongzhu.com) dials the Agent at http://localhost:8765.
# PORT=8765
#
# Loop tracing is on by default when NODE_ENV is not production.
# AGENT_LOOP_EVENTS=0
# AGENT_LOOP_LOG=0
